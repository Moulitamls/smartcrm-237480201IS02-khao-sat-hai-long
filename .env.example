# Sao chép: cp .env.example .env     (KHÔNG commit .env). Dự án này không có secret nào.
# Cổng dashboard mở ra máy chủ. Cổng 8501 bị chiếm thì đổi số này (ví dụ 8502).
APP_PORT=8501
# Tệp cấu hình pipeline cho lần chạy KHÔNG dùng Docker (README mục 3). docker-compose.yml tự ghi đè
# bằng src/config.docker.yaml, nên giá trị này không ảnh hưởng khi chạy bằng Docker.
CSAT_CONFIG=src/config.yaml
