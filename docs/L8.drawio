        <mxCell id="uc1" value="UC1 (US1 – MUST)&lt;br&gt;Gửi khảo sát hài lòng&lt;br&gt;cho phiếu đã đóng" style="ellipse;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#1F3A5F;strokeWidth=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="210" y="90" width="250" height="70" as="geometry"/></mxCell>
